[Unit]
Description=HunyuanWorld 2.0 (WorldMirror) Gradio UI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Drop-in for the Docker-based deployment. To use:
#   sudo cp deploy/systemd/hyworld.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hyworld.service
#
# If you prefer the native (venv) deployment instead, replace ExecStart with:
#   ExecStart=/opt/hyworld2/deploy/run_native.sh
# and drop the docker-related Requires=.

[Service]
Type=simple
WorkingDirectory=/opt/hyworld2
ExecStartPre=/usr/bin/docker compose -f deploy/docker-compose.yml pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
Restart=on-failure
RestartSec=10
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
